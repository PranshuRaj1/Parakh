#!/bin/sh
# Pre-push pipeline smoke test.
#
# Runs before `git push`. If any part of the comment → queue → triggerReview
# wiring is broken (the incident where reviews stopped being created after
# webhooks were deployed), the push is aborted so it never reaches production.
#
# Enabled repo-wide via `git config core.hooksPath .githooks` (see root
# package.json "setup" / "test:pipeline" scripts). To run manually:
#   npm run test:pipeline
echo "▶ Running pipeline smoke test before push..."
npm run test:pipeline
status=$?
if [ $status -ne 0 ]; then
  echo ""
  echo "✘ Pipeline smoke test FAILED — push aborted."
  echo "  Fix the broken comment→review wiring before pushing."
  exit 1
fi
echo "✓ Pipeline smoke test passed."
exit 0